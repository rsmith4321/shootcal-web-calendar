{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "shootcal-web-calendar/calendar",
	"version": "2.5.3",
	"title": "ShootCal Web Calendar",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "Connect a live ShootCal calendar with its ID, or display an iCal feed from Google, Apple, Outlook, or another provider.",
	"keywords": [
		"calendar",
		"availability",
		"booking",
		"photographer",
		"shootcal"
	],
	"textdomain": "shootcal-web-calendar",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": [
				"top",
				"bottom"
			]
		}
	},
	"attributes": {
		"months": {
			"type": "number"
		},
		"timezone": {
			"type": "string",
			"default": ""
		},
		"firstDay": {
			"type": "number"
		},
		"mode": {
			"type": "string",
			"default": "availability"
		},
		"url": {
			"type": "string",
			"default": ""
		},
		"multiSessionDay": {
			"type": "boolean",
			"default": true
		},
		"limitedColor": {
			"type": "string",
			"default": ""
		},
		"bookedColor": {
			"type": "string",
			"default": ""
		},
		"source": {
			"type": "string",
			"default": "auto",
			"enum": [
				"auto",
				"shootcal",
				"ical"
			]
		},
		"calendarId": {
			"type": "string",
			"default": ""
		},
		"embedView": {
			"type": "string",
			"enum": [
				"default",
				"calendar"
			]
		},
		"theme": {
			"type": "string",
			"enum": [
				"light",
				"dark"
			]
		},
		"embedParams": {
			"type": "object"
		}
	},
	"editorScript": "shootcal-web-calendar-block-editor",
	"editorStyle": "file:../../assets/css/editor.css"
}
